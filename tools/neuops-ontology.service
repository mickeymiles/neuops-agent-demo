# NeuOps 本体轨采购智能体 —— systemd 常驻单元（模板）
# 安装步骤（在服务器上，需 root 或 sudo）：
#   1. 把本文件放到 /etc/systemd/system/neuops-ontology.service
#      （并把 WorkingDirectory / User / 路径改成你的实际部署路径）
#   2. 确保仓库根目录 .env 已按要求填好（见 start_ontology_agent.sh 注释）
#   3. sudo systemctl daemon-reload
#      sudo systemctl enable --now neuops-ontology
#   4. 查看：sudo systemctl status neuops-ontology
#           journalctl -u neuops-ontology -f
[Unit]
Description=NeuOps Ontology Procurement Agent (本体轨采购智能体)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neuops-agent-demo
User=ubuntu
Environment=PYTHONPATH=/opt/neuops-agent-demo
Environment=ONT_MODE=ontology
Environment=ONT_EXEC=1
Environment=ONT_SCHEDULER=1
ExecStart=/opt/neuops-agent-demo/.venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/neuops-ontology.log
StandardError=append:/var/log/neuops-ontology.log

[Install]
WantedBy=multi-user.target
