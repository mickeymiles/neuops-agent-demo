# 备品备件采购询比价智能体凭据示例
# 复制本文件为 .env，填入真实凭据（.env 已 gitignore，不推 GitHub）
PROC_MAIL_USERNAME=your_email@163.com
PROC_MAIL_PASSWORD=your_163_auth_code
PROC_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
PROC_FEISHU_APP_SECRET=your_feishu_app_secret
PROC_FEISHU_PM_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# 跨工程对接（9007 -> 9006 contract-compare-9006）
#
# PROC_9006_DB_PATH 必须显式设置！
# 代码里的默认值是按服务器目录名拼的（app/config.py 与 app/db/contract_mail.py
# 均拼成 <上级目录>/contract-compare/contract_compare.db），目录名少了 "-9006"
# 后缀。本机仓库目录是 contract-compare-9006，默认路径必然不存在，
# 不显式指定会导致 9007 读写一个错误的库（共享 DB 通道静默失效）。
# ---------------------------------------------------------------------------
PROC_9006_DB_PATH=/absolute/path/to/contract-compare-9006/contract_compare.db
PROC_9006_BASE=http://127.0.0.1:9006
